# ───────────── 복사해서 .env 로 만든 뒤 값을 채우세요 (.env 는 절대 커밋 금지) ─────────────

# ── 서버 ──
NODE_ENV=development
PORT=4000
# 쉼표로 여러 개 가능. 개발 중 Vite 주소
CORS_ORIGIN=http://localhost:5173
# Nginx 같은 프록시 뒤에 둘 때 1 (프록시 단계 수)
TRUST_PROXY=0
# HTTPS 로 서비스할 때 true (리프레시 쿠키 Secure 속성)
COOKIE_SECURE=false
# API 서버가 apps/web/dist 도 같이 서빙할지 (Nginx 없이 쓸 때)
SERVE_WEB=false

# ── DB ──
DATABASE_URL=postgres://chat:change-me@localhost:5432/chat

# ── 인증 ──
# 32자 이상 랜덤 문자열. 생성: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# invite = 초대 코드 필요, open = 누구나 가입
REGISTRATION_MODE=invite
# 이 이메일로 가입하면 관리자 권한 + 초대 코드 없이 가입 가능 (첫 계정용)
ADMIN_EMAIL=

# ── 모델 서버 (OpenAI 호환 API) ──
# 개발 중: 클라우드 API 주소/키/모델명으로 바꿔 쓰세요
# 서버컴: llama.cpp(llama-server) 주소
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=none
LLM_MODEL=qwen3.6-35b-a3b
# 사용자가 화면에서 고를 수 있는 모델 목록 (선택). 쉼표로 구분, "모델ID=표시이름" 형식 가능.
# 비우면 LLM_MODEL 하나만 씁니다. LLM_MODEL 이 목록에 있으면 그게 기본 모델이에요.
# 예) LLM_MODELS=qwen3.5:9b=Qwen 3.5 9B,qwen3.5:4b=Qwen 3.5 4B (빠름)
LLM_MODELS=
# 동시에 생성할 수 있는 수 (llama-server 의 --parallel 값과 맞추세요)
LLM_CONCURRENCY=2
# 대기열 최대 길이 (넘으면 "잠시 후 다시 시도" 응답)
LLM_MAX_QUEUE=10
# 컨텍스트 길이(토큰). 넘으면 오래된 메시지부터 잘라냄
LLM_CONTEXT_TOKENS=32768
LLM_MAX_OUTPUT_TOKENS=8192
# Qwen 의 생각(reasoning) 모드. false 면 빠르지만 덜 깊게 생각 (llama.cpp·Ollama 둘 다 지원)
LLM_ENABLE_THINKING=true
# 모델을 메모리에 올리는 동안 기다릴 최대 시간(초). 큰 모델은 처음 쓸 때 몇 분 걸릴 수 있어요
LLM_LOAD_TIMEOUT_SEC=900
# Qwen 은 한국어로 물어도 영어로 생각하는 경우가 많아요. 생각의 첫 문장을 채워 넣어 한국어로 생각하게 합니다.
# (한국어 질문에만 적용, 비우면 끔)
LLM_THINKING_PREFIX=좋아, 한국어로 차근차근 생각해 보자.
# 위 기능을 쓸 모델 (모델 ID 앞부분, 쉼표로 구분). <think> 로 생각하는 모델에만 쓰세요 (gemma 등은 제외)
LLM_THINKING_PREFIX_MODELS=qwen3

# ── 사용 제한 ──
# IP 당 분당 제한. 학교 공유기처럼 한 IP 에서 여러 명이 접속하면 늘리세요
LOGIN_FAIL_LIMIT_PER_MIN=5
REGISTER_LIMIT_PER_MIN=10
# 사용자 당 분당 메시지 수
MESSAGE_RATE_PER_MIN=10
DAILY_MESSAGE_LIMIT=200
# 5시간마다 초기화되는 사용자당 토큰(질문+답변) 한도의 처음 기본값.
# 관리자 화면(사이드바 > 관리자)에서 바꾸면 그 값이 우선하고, 사용자마다 따로 정할 수도 있어요.
TOKEN_LIMIT_DEFAULT=100000
MAX_MESSAGE_CHARS=8000

# ── 내 컴퓨터 폴더 (AI 가 사용자 PC 폴더의 파일을 다루는 기능) ──
# 답변 하나를 만드는 동안 AI 가 쓸 수 있는 도구 호출 최대 횟수
AGENT_MAX_STEPS=20

# ── 웹 검색 (AI 가 검색·페이지 읽기) ──
# none(끔) | searxng(직접 설치, 키 없음) | tavily | brave (둘은 API 키 필요)
WEB_SEARCH_PROVIDER=none
# searxng 주소 (예: http://127.0.0.1:8888). settings.yml 의 search.formats 에 json 이 있어야 한다
WEB_SEARCH_URL=
WEB_SEARCH_API_KEY=
# 검색 한 번에 AI 에게 보여 줄 결과 수
WEB_SEARCH_RESULTS=8
# 페이지 하나에서 AI 에게 넘길 본문 최대 글자 수
WEB_FETCH_MAX_CHARS=6000

# --- docker compose 배포용 ---
# 반드시 강한 값으로 채우세요 (코드/깃에 넣지 마세요)
DB_PASSWORD=

# ── 파일 첨부 (이미지·PDF·워드·텍스트) ──
# 비우면 레포 안의 data/uploads
UPLOAD_DIR=
MAX_UPLOAD_MB=15
# 질문 하나에 붙인 문서들에서 AI 에게 넘길 글자 수 (길면 질문과 관련된 부분만 고른다)
ATTACH_CONTEXT_CHARS=8000
# 프로젝트 자료에서 AI 에게 넘길 글자 수 (자료가 많으면 질문과 관련된 부분만 고른다)
PROJECT_CONTEXT_CHARS=5000

# ── 구글 로그인·Gmail (README 의 "구글 로그인과 Gmail" 참고) ──
# Google Cloud Console → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID (웹 애플리케이션)
# 셋 다 채워야 켜진다. 비우면 구글 버튼이 보이지 않는다
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 구글 콘솔의 "승인된 리디렉션 URI" 에 똑같이 넣는다 (localhost 또는 https 도메인만 됨, IP 주소는 안 됨)
GOOGLE_REDIRECT_URI=http://localhost:4100/api/auth/google/callback

# ── 백업 (scripts/backup.ps1, 작업 스케줄러 "chat-site 백업" 이 매일 새벽 4시에 실행) ──
# 데이터가 있는 디스크와 다른 디스크에 두세요
BACKUP_DIR=C:\chat-site-backup
BACKUP_KEEP_DAYS=14

# ── 약관·감시 ──
# 개인정보 처리방침/이용약관에 공개되는 문의 이메일 (비우면 ADMIN_EMAIL)
CONTACT_EMAIL=
# 이 주소로 사이트가 열려 있는지 감시가 확인한다
PUBLIC_URL=https://smcaichat.zlero.xyz
# 문제가 생기면 알림을 받을 디스코드/슬랙 웹훅 주소 (비우면 로그에만 남김)
ALERT_WEBHOOK_URL=

# ── 디스코드 봇 (사용자가 설정 화면에서 자기 봇을 연결) ──
# false 면 사용자가 연결해도 봇을 켜지 않는다 (비상 스위치)
DISCORD_BOTS_ENABLED=true
# 봇을 부르는 디스코드 사용자 한 명당 제한 (사용량은 봇 주인의 5시간 사용량에서 나간다)
DISCORD_MESSAGES_PER_HOUR=20
DISCORD_MESSAGES_PER_DAY=100
